# Copia este archivo como .env SOLO en tu entorno local/servidor.
# .env está ignorado por Git. Nunca publiques valores reales.
FRAPPE_BASE_URL=https://tu-instancia.example.com
FRAPPE_API_KEY=replace_me
FRAPPE_API_SECRET=replace_me

# Opcionales
# LIVINGORG_REPO_ROOT=/ruta/absoluta/al/repositorio
# FRAPPE_TIMEOUT_SECONDS=90

# Sólo para operaciones destructivas explícitas (reinstall.py / cleanup_data.py)
# LIVINGORG_ALLOW_DESTRUCTIVE=1
