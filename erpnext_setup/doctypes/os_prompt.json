      "default": "Draft",
      "in_list_view": 1
    },
    {
      "fieldname": "system_instruction",
      "label": "System Instruction",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "task_template",
      "label": "Task Template",
      "fieldtype": "Code"
    },
    {
      "fieldname": "context_template",
      "label": "Context Template",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "tool_policy",
      "label": "Tool Policy",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "output_schema",
      "label": "Output Schema",
      "fieldtype": "Code",
      "options": "JSON"
    },
    {
      "fieldname": "fallback",
      "label": "Fallback",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "approval_policy",
      "label": "Approval Policy",
