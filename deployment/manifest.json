{
  "product": "LivingOrg OS",
  "schema_version": "1.0",
  "deployment_contract_version": "1.0",
  "portal_route": "os",
  "source_of_truth": {
    "doctypes": "erpnext_setup/doctypes",
    "portal": "portal",
    "permissions": "scripts/permissions.py",
    "schema_overlays": "scripts/schema_overlays.py"
  },
  "supported_modes": {
    "bench": {
      "label": "Native Frappe Custom App",
      "runtime": "livingorg_bridge",
      "requires_ssh": true,
      "requires_bench": true,
      "supports_server_hooks": true,
      "supports_document_permission_hooks": true,
      "supports_operational_actions": true,
      "recommended_for": "full-native-production"
    },
    "api": {
      "label": "API-First / OpenClaw",
      "runtime": "rest",
      "requires_ssh": false,
      "requires_bench": false,
      "supports_schema_sync": true,
      "supports_role_sync": true,
      "supports_asset_sync": true,
      "supports_web_page_sync": true,
      "supports_server_hooks": false,
      "supports_document_permission_hooks": false,
      "operational_runtime": [
        "external-openclaw-runtime",
        "server-script-runtime-when-enabled"
      ],
      "recommended_for": "restricted-hosting-or-api-only-installations"
    }
  },
  "safety": {
    "default_safe_mode": true,
    "delete_schema_objects": false,
    "drop_fields": false,
    "truncate_data": false,
    "reinstall": false,
    "store_secrets_in_repo": false
  },
  "required_environment": [
    "FRAPPE_BASE_URL",
    "FRAPPE_API_KEY",
    "FRAPPE_API_SECRET"
  ],
  "roles": [
    "OS Admin",
    "OS Architect",
    "OS Publisher",
    "OS AI Supervisor",
    "OS Manager",
    "OS Operator",
    "OS Auditor",
    "OS Viewer"
  ],
  "verification": {
    "bridge_capability_endpoint": "livingorg_bridge.status.capabilities",
    "api_identity_endpoint": "frappe.auth.get_logged_user"
  }
}
